<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/surface" app:cardCornerRadius="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/tvWifiSsid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvWifiBssid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="11sp"
            android:fontFamily="monospace" android:paddingTop="2dp"/>
        <TextView android:id="@+id/tvWifiInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="11sp" android:paddingTop="4dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
